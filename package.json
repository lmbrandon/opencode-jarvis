{
  "name": "opencode-jarvis",
  "version": "0.1.0",
  "description": "JARVIS-style voice and TUI plugin for OpenCode",
  "keywords": [
    "opencode",
    "plugin",
    "jarvis",
    "voice",
    "tui"
  ],
  "type": "module",
  "license": "MIT",
  "engines": {
    "opencode": ">=2.0.0 <3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./rpc": {
      "types": "./dist/rpc.d.ts",
      "import": "./dist/rpc.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/rpc.ts src/tui.ts --format esm --dts --clean --out-dir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude tests/package-artifacts.test.ts",
    "smoke:v2": "node testing/smoke-v2.mjs",
    "test:package": "npm run build && vitest run tests/package.test.ts tests/package-artifacts.test.ts && npm pack --dry-run --json",
    "check": "npm run typecheck && npm test && npm run test:package"
  },
  "dependencies": {
    "@opencode/plugin": "2.0.29"
  },
  "devDependencies": {
    "@opencode/theme": "^2.0.29",
    "@opentui/core": "^0.5.17",
    "@opentui/solid": "^0.5.17",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^24.0.0",
    "solid-js": "^1.9.12",
    "tsup": "^8.5.0",
    "typescript": "^5.8.2",
    "vitest": "^3.2.4"
  },
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "author": ""
}
